PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/edupulse?retryWrites=true

# Auth
JWT_ACCESS_SECRET=your_access_secret_minimum_64_chars_here_please_change
JWT_REFRESH_SECRET=your_refresh_secret_minimum_64_chars_here_please_change
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
BCRYPT_ROUNDS=12

# OAuth
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxx
GITHUB_CLIENT_ID=xxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxx
PLATFORM_FEE_PERCENT=10

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=xxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxx

# Email (Gmail SMTP via nodemailer)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=noreply@edupulse.com
EMAIL_FROM_NAME=EduPulse

# Redis (leave empty to use in-memory fallback for dev)
REDIS_URL=redis://localhost:6379

# Misc
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CERTIFICATE_SECRET=cert_secret_key_change_this
